{
  "version": 1,
  "channel": "news",
  "display_name": "AI على السريع",
  "palette_source": "config/channel_identity.json",
  "canvas": {
    "w": 1080,
    "h": 1920,
    "fps": 30
  },
  "palette": {
    "bg": "#f1f3e9",
    "ink": "#14252d",
    "accent": "#426d34",
    "muted": "#6b7a70"
  },
  "font": {
    "bold": "assets/NotoSansArabic-Bold.ttf",
    "regular": "assets/NotoSansArabic-Regular.ttf"
  },
  "card": {
    "radius": 24,
    "border": "#14252d",
    "shadow": 0.08
  },
  "title": {
    "y": 300,
    "size": 84,
    "max_lines": 2,
    "accent_rule": "exactly_one_word"
  },
  "caption": {
    "anchor": "bottom",
    "y_bottom": 1248,
    "size": 48,
    "align": "rtl",
    "max_lines": 2
  },
  "source_chip": {
    "y": 1030,
    "size": 34,
    "show_date": true,
    "show_publisher": true,
    "note": "moved from y 1720 — that was under the Shorts UI; must not overlap the caption box (top >= 1073)"
  },
  "safe": {
    "top": 290,
    "bottom": 1248
  },
  "safe_zone": {
    "profile": "multi_platform_v1",
    "version": 1,
    "text_x": [
      190,
      890
    ],
    "text_y": [
      290,
      1248
    ],
    "text_x_lower": {
      "from_y": 840,
      "x": [
        190,
        780
      ]
    },
    "caption_anchor": "bottom",
    "caption_y_bottom": 1248,
    "caption_max_lines": 2,
    "caption_max_width": 590,
    "caption_center_x": 485,
    "caption_max_height": 175,
    "dead_zone_y_from": 1248,
    "dead_zone_x_each_side": 190,
    "chrome_min_y": 130,
    "art_stage": {
      "focal_x": [
        190,
        890
      ],
      "focal_y": [
        520,
        1070
      ],
      "min_scale_vs_reference": 0.85,
      "background": "full_bleed_1080x1920"
    }
  },
  "motion": {
    "in": "card_slide_up",
    "out": "card_fade",
    "max_zoom": 1.0,
    "no_cinematic_bed": true
  },
  "hook": {
    "max_words": 12,
    "max_seconds": 2.5
  },
  "duration_seconds": {
    "min_exclusive": 60,
    "max_exclusive": 180
  },
  "locked": true,
  "layout": {
    "brand_y": 150,
    "brand_size": 26,
    "review_y": 210,
    "review_size": 22,
    "title_bottom": 530,
    "title_width": 698,
    "title_line_height": 1.12,
    "focal_reference_max_extent": 610,
    "focal_display_scale": 0.9,
    "caption_padding": [
      14,
      18
    ],
    "caption_radius": 18,
    "caption_opacity": 0.92,
    "caption_line_height": 1.25,
    "mask_colors": {
      "title": "#ff0000",
      "caption": "#00ff00",
      "disclaimer": "#0000ff",
      "source": "#ff00ff",
      "brand": "#00ffff",
      "review": "#ffff00"
    },
    "title_right_clearance_note": "The conservative Shorts checker reserves x>=888; title container ends at 888, two pixels inside the rounded text_x limit 890."
  },
  "public_title_prefix": "من أخبار الأسبوع: "
}
