    {
      "text": "اللي بيقوله المطور لازم نفرّقه عن",
      "start": 23.02,
      "end": 25.02
    },
    {
      "text": "تقييم مستقل للقدرات. لو هنقارن بالإصدارات",
      "start": 25.34,
      "end": 28.42
    },
    {
      "text": "السابقة، لازم نبص لشروط الاختبار. شكل",
      "start": 28.42,
      "end": 31.82
    },
    {
      "text": "المجسم هنا شرح للفكرة، مش رسم",
      "start": 31.82,
      "end": 35.02
    },
    {
      "text": "لنتائج أو نسب جديدة. الوصول للنموذج",
      "start": 35.66,
      "end": 38.04
    },
    {
      "text": "بيبدأ تدريجي مع شركاء ومدافعين سيبرانيين.",
      "start": 38.5,
      "end": 41.9
    },
    {
      "text": "عشان كده، الإعلان عنه مش معناه",
      "start": 41.9,
      "end": 43.44
    },
    {
      "text": "إن كل الناس تقدر تستخدمه فوراً.",
      "start": 43.72,
      "end": 45.3
    },
    {
      "text": "المصدر بيعرض تفاصيل لتكلفة الاستخدام. بس",
      "start": 46.22,
      "end": 49.2
    },
    {
      "text": "قبل ما تبني عليه مشروع، راجع",
      "start": 49.2,
      "end": 50.6
    },
    {
      "text": "التسعير الحالي وشروط الوصول بنفسك. زي",
      "start": 51.3,
      "end": 54.08
    },
    {
      "text": "أي نموذج قوي، موضوع السلامة والمخاطر",
      "start": 54.08,
      "end": 56.38
    },
    {
      "text": "محتاج مراجعة. القدرة المعلنة مش ضمان",
      "start": 56.4,
      "end": 59.26
    },
    {
      "text": "إن كل نتيجة هتطلع صحيحة. اللي",
      "start": 59.26,
      "end": 62.04
    },
    {
      "text": "يستاهل المتابعة هو التجارب الفعلية بعد",
      "start": 62.3,
      "end": 64.26
    },
    {
      "text": "الإتاحة. هل المهام الطويلة هتتحسن في",
      "start": 64.26,
      "end": 67.04
    },
    {
      "text": "شغلك؟ ده سؤال نحكم عليه بالتجربة.",
      "start": 67.04,
      "end": 69.38
    }
  ],
