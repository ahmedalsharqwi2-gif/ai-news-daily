      "text": "يشغلوا وكلاء ذكاء اصطناعي بيشتغلوا في",
      "start": 17.24,
      "end": 19.42
    },
    {
      "text": "الخلفية جنب التطبيقات الأساسية من خلال",
      "start": 19.42,
      "end": 21.74
    },
    {
      "text": "تطبيق إنفيديا الجديد. نموذج نيموترون ثلاثة",
      "start": 21.74,
      "end": 23.28
    },
    {
      "text": "ونصف الجديد بينافس بقوة عشان يحول",
      "start": 25.06,
      "end": 27.28
    },
    {
      "text": "الصوت المكتوب لمعلومات مفيدة وترجمة دقيقة",
      "start": 27.28,
      "end": 30.18
    },
    {
      "text": "بأربعين لغة مختلفة. تطبيقات ليكويد إيه",
      "start": 31.14,
      "end": 33.1
    },
    {
      "text": "آي أصبحت متاحة بدعم محلي كامل",
      "start": 33.64,
      "end": 35.72
    },
    {
      "text": "عشان تساعد المستخدمين في تنظيم المواعيد",
      "start": 35.72,
      "end": 37.34
    },
    {
      "text": "وقراءة المستندات بسرعة فائقة. ألعاب زي",
      "start": 38.52,
      "end": 41.1
    },
    {
      "text": "فانتوم بليد زيرو بتنزل بدعم تقنية",
      "start": 42.28,
      "end": 43.4
    },
    {
      "text": "تتبع الأشعة وتوليد الإطارات الديناميكي عشان",
      "start": 43.4,
      "end": 46.38
    },
    {
      "text": "تدي أداء سلس ومذهل للغاية. منصة",
      "start": 46.38,
      "end": 49.7
    },
    {
      "text": "آر تي إكس ريمكس نسخة ستة",
      "start": 50.72,
      "end": 51.1
    },
    {
      "text": "دخلت عالم ماين كرافت لتطوير رسومات",
      "start": 51.52,
      "end": 53.68
    },
    {
      "text": "الألعاب الكلاسيكية باستخدام الإضاءة المسارية والذكاء",
      "start": 53.68,
      "end": 56.86
    },
    {
      "text": "الاصطناعي. الأجهزة دي بقت تقدم للمطورين",
      "start": 56.86,
      "end": 59.68
    },
    {
      "text": "والمبدعين قدرات محطات العمل الثقيلة في",
      "start": 60.58,
      "end": 62.74
    },
    {
      "text": "حاسوب محمول خفيف الوزن يمكن حمله",
      "start": 63.02,
      "end": 65.22
    },
    {
      "text": "في أي مكان بسهولة.",
      "start": 65.22,
      "end": 66.38
    }
  ],
