  "scenes": [
    {
      "id": "scene_1",
      "label": "إطلاق النماذج",
      "narration": "أطلقت هاجينج فيس حزمتين جديدتين لتوسيع الذكاء الاصطناعي على أجهزة أبل، وهما أني سبوتش ريكوغنايزر وأني ديسيشن موديل، لنقل التعرف على الصوت واتخاذ القرارات لبيئة سويفت المحلية. يعني التليفون يدخل اجتماع العيلة ويفهم مين قال إيه، وإحنا لسه بنقول يا جماعة واحد واحد.",
      "labels": [],
      "visual_mode": "chip",
      "evidence_excerpt_id": 8,
      "punchline": "يا جماعة واحد واحد.",
      "reaction": "loading",
      "evidence_quote": "speech and decisions: familiar Swift APIs with a choice of model. Today we're announcing two",
      "start": 0,
      "end": 16.48,
      "meme_beat": 14.9,
      "meme_end": 16.48
    },
    {
      "id": "scene_2",
      "label": "محركات الصوت",
      "narration": "بيتيح محرك أني سبوتش اختيار محركات التعرف على الكلام زي باراكيت من إنفيديا أو كيو ون ثري من أليبابا، مع دعم تشغيل النماذج محلياً على كور إم إل.",
      "labels": [],
      "visual_mode": "flow",
      "evidence_excerpt_id": 10,
      "punchline": "",
      "reaction": "none",
      "evidence_quote": "Parakeet and Alibaba's Qwen3-ASR running locally on Core ML, and adds speaker diarization to track",
      "start": 16.48,
      "end": 26.48
    },
    {
      "id": "scene_3",
      "label": "تتبع المتحدثين",
      "narration": "الناس اللي بتسأل عن تحديد مين تكلم ومتى، الحزمة بتضيف ميزة فصل المتحدثين باستخدام نموذج ستريمنج سورتفورمر، عشان تتبع لحد أربعة أشخاص بيتكلموا في نفس الوقت. أربعة بيتكلموا فوق بعض؟ ده مش اختبار ذكاء اصطناعي، ده جروب العيلة لما حد يسأل مين جاب آخر حتة كنافة.",
      "labels": [
        "تحديد مين تكلم ومتى"
      ],
      "visual_mode": "network",
      "evidence_excerpt_id": 53,
      "punchline": "مين جاب آخر حتة كنافة.",
      "reaction": "shock",
      "evidence_quote": "the same timeline: The diarizer tracks up to four speakers, even when they talk over",
      "start": 26.48,
      "end": 42.52,
      "meme_beat": 40.86,
      "meme_end": 42.02
    },
    {
      "id": "scene_4",
      "label": "مقارنة الأداء",
      "narration": "حسب القياسات على جهاز ماك استوديو، باراكيت بينجز ساعة تسجيل في ثوانٍ معدودة، بينما كيو ون ثري أبطأ وبيلزمو رامات أكتر بكتير لتنفيذ نفس المهمة.",
      "labels": [],
      "visual_mode": "comparison",
      "evidence_excerpt_id": 61,
      "punchline": "",
      "reaction": "none",
      "evidence_quote": "Parakeet transcribes an hour of audio in about 20 to 40 seconds from a file,",
      "start": 42.52,
      "end": 51.54
    },
    {
      "id": "scene_5",
      "label": "اتخاذ القرارات",
      "narration": "أما أني ديسيشن موديل فبيقدم طريقة جديدة للإجابة على الأسئلة بنعم أو لا، أو الاختيار من متعدد، من غير توليد نصوص طويلة مالهاش لازمة. نعم أو لا من غير محاضرة؟ ابعتوا النموذج ده لأي حد بنسأله سؤال بسيط ويرد علينا برسالة صوتية عشر دقايق.",
      "labels": [],
      "visual_mode": "deployment",
      "evidence_excerpt_id": 11,
      "punchline": "برسالة صوتية عشر دقايق.",
      "reaction": "suspicious",
      "evidence_quote": "who speaks when. AnyDecisionModel answers yes-or-no, multiple-choice, and rating-scale questions with typed results and probabilities.",
