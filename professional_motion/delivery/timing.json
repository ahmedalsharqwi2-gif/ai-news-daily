      "text": "زمان كان مدير الموقع لازم يحدد",
      "start": 17.06,
      "end": 19.46
    },
    {
      "text": "كل زاحف لوحده ويعمل قواعد منفصلة",
      "start": 19.46,
      "end": 21.98
    },
    {
      "text": "لكل مزود ذكاء اصطناعي من غير",
      "start": 21.98,
      "end": 24.04
    },
    {
      "text": "ما يرتاح. وجود إشارة مشتركة عبر",
      "start": 24.04,
      "end": 26.66
    },
    {
      "text": "مزودين كتير بيقلل المجهود الضخم ده",
      "start": 26.66,
      "end": 29.36
    },
    {
      "text": "عن أصحاب المواقع اللي بيديروا منصاتهم",
      "start": 29.36,
      "end": 31.3
    },
    {
      "text": "بنفسهم كل يوم. الشركة ناوية تطبق",
      "start": 31.3,
      "end": 33.38
    },
    {
      "text": "الإشارة دي في الشهور الجاية، وهتنزل",
      "start": 33.74,
      "end": 35.82
    },
    {
      "text": "تحديث تاني بكل تفاصيل التنفيذ أول",
      "start": 35.82,
      "end": 38.12
    },
    {
      "text": "ما الأمور توضح. الإشارة الجديدة مش",
      "start": 38.12,
      "end": 40.26
    },
    {
      "text": "هتلغي أدوات التحكم اللي أصلاً موجودة",
      "start": 40.26,
      "end": 42.64
    },
    {
      "text": "في ملفات روبوتس تكس، والتحكم القديم",
      "start": 42.64,
      "end": 44.64
    },
    {
      "text": "هيفضل شغال ومحترم. الخطوة دي مستوحاة",
      "start": 45.0,
      "end": 47.56
    },
    {
      "text": "من الشغل المستمر لمجموعة عمل تفضيلات",
      "start": 48.02,
      "end": 49.7
    },
    {
      "text": "الذكاء الاصطناعي التابعة لهيئة مهندسي الإنترنت",
      "start": 50.52,
      "end": 52.86
    },
    {
      "text": "العالمية. المشاركة دي بتقوي دور الشركة",
      "start": 52.86,
      "end": 55.78
    },
    {
      "text": "في نقاشات المعايير، وبتعتبر خطوة عملية",
      "start": 55.78,
      "end": 58.36
    },
    {
      "text": "نحو ويب مفتوح وأصحاب مواقع عندهم",
      "start": 58.36,
      "end": 61.13
    },
    {
      "text": "طرق أوضح.",
      "start": 61.13,
      "end": 61.83
    }
  ],
