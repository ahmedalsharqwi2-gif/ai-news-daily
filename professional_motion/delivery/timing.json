  "caption_groups": [
    {
      "text": "أطلقت هاجينج فيس حزمتين جديدتين لتوسيع",
      "start": 0,
      "end": 2.7
    },
    {
      "text": "الذكاء الاصطناعي على أجهزة أبل، وهما",
      "start": 2.7,
      "end": 5.22
    },
    {
      "text": "أني سبوتش ريكوغنايزر وأني ديسيشن موديل،",
      "start": 5.22,
      "end": 7.7
    },
    {
      "text": "لنقل التعرف على الصوت واتخاذ القرارات",
      "start": 7.7,
      "end": 9.94
    },
    {
      "text": "لبيئة سويفت المحلية. يعني التليفون يدخل",
      "start": 9.96,
      "end": 12.54
    },
    {
      "text": "اجتماع العيلة ويفهم مين قال إيه،",
      "start": 12.54,
      "end": 14.16
    },
    {
      "text": "وإحنا لسه بنقول يا جماعة واحد",
      "start": 14.16,
      "end": 15.96
    },
    {
      "text": "واحد. بيتيح محرك أني سبوتش اختيار",
      "start": 15.96,
      "end": 18.56
    },
    {
      "text": "محركات التعرف على الكلام زي باراكيت",
      "start": 18.56,
      "end": 20.7
    },
    {
      "text": "من إنفيديا أو كيو ون ثري",
      "start": 20.84,
      "end": 21.8
    },
    {
      "text": "من أليبابا، مع دعم تشغيل النماذج",
      "start": 22.34,
      "end": 24.76
    },
    {
      "text": "محلياً على كور إم إل. الناس",
      "start": 24.76,
      "end": 26.88
    },
    {
      "text": "اللي بتسأل عن تحديد مين تكلم",
      "start": 26.88,
      "end": 28.32
    },
    {
      "text": "ومتى، الحزمة بتضيف ميزة فصل المتحدثين",
      "start": 28.54,
      "end": 31.1
    },
    {
      "text": "باستخدام نموذج ستريمنج سورتفورمر، عشان تتبع",
      "start": 31.1,
      "end": 34.08
    },
    {
      "text": "لحد أربعة أشخاص بيتكلموا في نفس",
      "start": 34.08,
      "end": 35.9
    },
    {
      "text": "الوقت. أربعة بيتكلموا فوق بعض؟ ده",
      "start": 35.9,
      "end": 38.16
    },
    {
      "text": "مش اختبار ذكاء اصطناعي، ده جروب",
      "start": 38.16,
      "end": 39.92
    },
    {
      "text": "العيلة لما حد يسأل مين جاب",
      "start": 39.92,
      "end": 41.24
    },
    {
      "text": "آخر حتة كنافة. حسب القياسات على",
      "start": 41.24,
      "end": 43.74
    },
    {
      "text": "جهاز ماك استوديو، باراكيت بينجز ساعة",
      "start": 43.74,
      "end": 45.12
    },
    {
      "text": "تسجيل في ثوانٍ معدودة، بينما كيو",
      "start": 46.22,
      "end": 47.8
    },
    {
      "text": "ون ثري أبطأ وبيلزمو رامات أكتر",
      "start": 48.48,
      "end": 50.06
    },
    {
      "text": "بكتير لتنفيذ نفس المهمة. أما أني",
      "start": 50.06,
      "end": 52.62
    },
    {
      "text": "ديسيشن موديل فبيقدم طريقة جديدة للإجابة",
      "start": 52.62,
      "end": 55.12
    },
    {
      "text": "على الأسئلة بنعم أو لا، أو",
      "start": 55.1,
      "end": 56.74
    },
    {
      "text": "الاختيار من متعدد، من غير توليد",
      "start": 56.74,
      "end": 58.68
    },
    {
      "text": "نصوص طويلة مالهاش لازمة. نعم أو",
      "start": 58.68,
      "end": 61.12
    },
    {
      "text": "لا من غير محاضرة؟ ابعتوا النموذج",
      "start": 61.12,
      "end": 62.88
    },
    {
      "text": "ده لأي حد بنسأله سؤال بسيط",
      "start": 63.0,
      "end": 64.26
    },
    {
      "text": "ويرد علينا برسالة صوتية عشر دقايق.",
      "start": 64.26,
      "end": 66.16
    },
    {
      "text": "تطبيق إيموجي ماجنت بيوضح قدرة النماذج",
      "start": 66.72,
      "end": 69.2
    },
    {
      "text": "دي، حيث بيصنف مئات الإيموجي مباشرة",
      "start": 69.2,
      "end": 72.2
    },
    {
      "text": "على جهازك بناءً على كتابتك، بدون",
      "start": 72.2,
      "end": 74.98
    },
    {
      "text": "أي قواعد كلمات مفتاحية مسبقة. التشغيل",
      "start": 74.98,
      "end": 77.86
    },
    {
      "text": "المحلي ليه متطلبات للنظام والجهاز ومساحة",
      "start": 78.38,
      "end": 81.46
    },
    {
      "text": "التخزين. يعني قبل التجربة، المطور لازم",
      "start": 81.46,
      "end": 84.82
    },
    {
      "text": "يراجع إصدار النظام وحجم النموذج المناسب",
      "start": 84.82,
      "end": 87.52
    },
    {
      "text": "لجهازه، مش يفترض إن أي جهاز",
      "start": 87.52,
      "end": 89.48
    },
    {
      "text": "هيشغّل أي نموذج بنفس الأداء. بس",
      "start": 89.48,
      "end": 92.02
    },
    {
      "text": "خليك صاحي لمساحة التخزين؛ قبل ما",
      "start": 92.0,
      "end": 94.04
    },
    {
      "text": "تفرح بالذكاء الجديد، ممكن الماك يطلب",
      "start": 94.04,
      "end": 96.32
    },
    {
      "text": "منك تمسح فولدر اسمه نسخة نهائية",
      "start": 96.32,
      "end": 98.46
    },
