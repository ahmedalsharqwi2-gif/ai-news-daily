      "start": 146.08,
      "end": 146.46
    },
    {
      "text": "الدليل",
      "start": 146.46,
      "end": 146.78
    },
    {
      "text": "وحده",
      "start": 146.78,
      "end": 147.32
    },
    {
      "text": "نتيجة",
      "start": 147.32,
      "end": 147.66
    },
    {
      "text": "مضمونا",
      "start": 147.66,
      "end": 148.04
    }
  ],
  "caption_groups": [
    {
      "text": "أوبن إيه آي أعلنت تحديث لدليل",
      "start": 0,
      "end": 2.12
    },
    {
      "text": "سلوك نماذجها، اللي بتسميه موديل سبيك.",
      "start": 2.12,
      "end": 3.86
    },
    {
      "text": "الخبر هنا مش إطلاق موديل جديد،",
      "start": 4.9,
      "end": 6.92
    },
    {
      "text": "لكن تغيير في المبادئ اللي الشركة",
      "start": 6.92,
      "end": 8.78
    },
    {
      "text": "عايزة النماذج تتصرف على أساسها. يعني",
      "start": 8.78,
      "end": 11.08
    },
    {
      "text": "بنراجع طريقة المساعدة واتخاذ القرارات، مش",
      "start": 11.06,
      "end": 13.46
    },
    {
      "text": "بنعلن قفزة أداء اتقاست في اختبار.",
      "start": 13.46,
      "end": 15.94
    },
    {
      "text": "التحديث بيرتب الدليل حوالين خمس قيم:",
      "start": 16.02,
      "end": 18.14
    },
    {
      "text": "فهم نية الإنسان، وتقليل الضرر، والصدق",
      "start": 18.14,
      "end": 21.68
    },
    {
      "text": "والشفافية، ودعم قدرة الناس على الاختيار،",
      "start": 21.68,
      "end": 24.5
    },
    {
      "text": "ومراعاة ظروفهم. الفكرة إن النموذج يفهم",
      "start": 24.94,
      "end": 27.46
    },
    {
      "text": "ليه القاعدة موجودة، بدل ما ينفذ",
      "start": 27.46,
      "end": 29.12
    },
    {
      "text": "كلامك بالحرف ويطلع بنتيجة ملهاش علاقة",
      "start": 29.44,
      "end": 31.62
    },
    {
      "text": "بالهدف اللي كنت تقصده. من الأمثلة",
      "start": 31.62,
      "end": 33.86
    },
    {
      "text": "اللي الشركة ذكرتها مقارنة عروض الشغل.",
      "start": 33.86,
      "end": 36.24
    },
    {
      "text": "لو كنت قلت قبل كده إن",
      "start": 36.24,
      "end": 37.28
    },
    {
      "text": "مواعيد الشغل المنتظمة مهمة لك، النموذج",
      "start": 37.54,
      "end": 39.88
    },
    {
      "text": "ممكن ياخد ده في الاعتبار، بس",
      "start": 39.94,
      "end": 41.5
    },
    {
      "text": "يوضح افتراضاته ويخليك تصححها. مساعد ذكي",
      "start": 41.5,
      "end": 44.9
    },
    {
      "text": "آه، مدير لحياتي لأ. القرار يفضل",
      "start": 44.9,
      "end": 47.66
    },
    {
      "text": "قرارك أنت، مش تفضيل مخفي يفرضه",
      "start": 47.66,
      "end": 49.26
    },
    {
      "text": "عليك. الدليل كمان بينظم ترتيب التعليمات",
      "start": 49.52,
      "end": 52.34
    },
    {
      "text": "وحل التعارض بينها. الشركة بتحط حدود،",
      "start": 52.34,
      "end": 54.9
    },
    {
      "text": "والمطور بيحدد التطبيق داخل الحدود دي،",
      "start": 54.9,
      "end": 57.62
    },
    {
      "text": "والمستخدم بيوجه الشغل. مش كل رسالة",
      "start": 57.64,
      "end": 59.96
    },
    {
      "text": "تقول أنا المدير يبقى نديها ختم",
      "start": 59.96,
      "end": 61.56
    },
    {
      "text": "النسر. دي قفشة على لخبطة التعليمات،",
      "start": 61.56,
      "end": 63.8
    },
    {
      "text": "أما التحديث نفسه فبيشرح إزاي النموذج",
      "start": 63.8,
      "end": 66.7
    },
    {
      "text": "يحدد أنهي تعليمات تنطبق. قسم جديد",
      "start": 66.9,
      "end": 69.88
    },
    {
      "text": "بيركز على فهم السياق بعناية: المحادثات",
      "start": 69.88,
      "end": 72.68
    },
    {
      "text": "والذاكرة والأدلة المتاحة تساعد النموذج يفهم",
      "start": 72.68,
      "end": 76.14
    },
    {
      "text": "نواياك وتفضيلاتك. لكن ده مش تصريح",
      "start": 76.14,
      "end": 78.68
    },
    {
      "text": "إنه يتصرف نيابة عنك من غير",
      "start": 78.68,
      "end": 80.14
    },
    {
      "text": "حدود. الدليل بيتكلم كمان عن توضيح",
      "start": 80.14,
      "end": 82.8
    },
    {
      "text": "الآثار الجانبية للشغل، ومراعاة تأثيره على",
      "start": 82.8,
      "end": 85.62
    },
    {
      "text": "ناس تانية، مع احترام هدفك وتعليماتك.",
      "start": 85.62,
      "end": 87.86
    },
    {
      "text": "في المقابل، معظم تعليمات الأسلوب التفصيلية",
      "start": 88.7,
      "end": 91.42
    },
    {
      "text": "القديمة اتشالت، عشان الأسلوب يتكيف مع",
      "start": 91.98,
      "end": 93.68
    },
    {
      "text": "اللغة والثقافة وتفضيل كل شخص. لكن",
      "start": 93.68,
      "end": 96.76
    },
    {
      "text": "الحياد فضل مبدأ أقوى؛ النموذج ما",
      "start": 96.76,
      "end": 99.82
    },
    {
      "text": "يفترضش رأيك لمجرد إنه فاكر إنك",
      "start": 100.44,
      "end": 102.5
    },
    {
      "text": "عايز تسمعه. مش كل ما أقول",
      "start": 102.5,
      "end": 104.24
    },
    {
      "text": "رأيي يقول لي إنت أسطورة. المجاملة",
      "start": 104.48,
      "end": 106.36
    },
    {
      "text": "مش دليل صحة. الصدق هنا يشمل",
      "start": 106.36,
      "end": 109.24
    },
    {
      "text": "إن النموذج يوضح اللي يعرفه، واللي",
      "start": 109.24,
      "end": 111.76
    },
    {
      "text": "عمله، والحاجات اللي مش متأكد منها.",
      "start": 111.76,
      "end": 113.96
    },
    {
      "text": "ده مهم عشان تقدر تقيّم النتيجة",
      "start": 113.96,
      "end": 116.44
    },
    {
      "text": "بدل ما تتأثر بصوت واثق وخلاص.",
      "start": 116.88,
      "end": 118.78
    },
    {
      "text": "الثقة مش بالصوت العالي، المهم المعلومة",
      "start": 119.66,
      "end": 121.64
    },
    {
      "text": "صح. التعليق ده ساخر، ومش وعد",
      "start": 121.64,
      "end": 124.64
    },
    {
      "text": "إن الأخطاء اختفت من المنتجات. والنقطة",
      "start": 124.64,
      "end": 125.96
    },
    {
      "text": "الأهم في آخر الإعلان: الشركة بتقول",
      "start": 127.52,
      "end": 129.96
    },
    {
      "text": "إن نماذجها لسه مش بتعكس الدليل",
      "start": 129.96,
      "end": 131.9
    },
    {
      "text": "بالكامل. يعني فيه فرق بين السلوك",
      "start": 131.9,
      "end": 134.22
    },
    {
      "text": "المستهدف والتنفيذ الحالي. هم طالبين ملاحظات",
      "start": 134.22,
      "end": 138.06
    },
    {
      "text": "على القيم والتوازنات والصياغة، وبيقولوا إن",
      "start": 138.06,
      "end": 141.62
    },
    {
      "text": "الدليل والنماذج هيفضلوا يتطوروا. نتابع التطبيق",
      "start": 141.62,
      "end": 144.66
    },
    {
      "text": "الفعلي، وما نعتبرش تحديث الدليل وحده",
      "start": 144.66,
      "end": 147.0
    },
    {
      "text": "نتيجة مضمونة.",
      "start": 147.0,
      "end": 147.96
    }
  ],
