    "scenes": [
      {
        "label": "منصة واحدة بدل التوهان",
        "narration": "فاتح كورسات في عشر تبويبات ومش عارف تبدأ منين؟ جوجل أعلنت يوم اتنين نوفمبر منصة سكيلينج أفريكا، بتجمع تدريبها الرقمي ومهارات الذكاء الاصطناعي في مكان واحد.",
        "visual": {
          "kind": "platform",
          "labels": [
            "تعلّم مهارات رقمية",
            "موارد تدريب في مكان واحد",
            "إعلان جوجل • 2 نوفمبر 2026"
          ]
        },
        "id": "scene_1",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "هدفها تدريب 3 ملايين شخص",
        "narration": "الهدف المعلن تجهيز تلاتة مليون شخص في أفريقيا بالمهارات دي بحلول ألفين وتلاتين. ده هدف للبرنامج، مش عدد ناس خلصت التدريب بالفعل؛ الفرق مهم.",
        "visual": {
          "kind": "metric",
          "number": "3 ملايين",
          "detail": "هدف تدريب بحلول 2030 • وليس نتيجة تحققت"
        },
        "id": "scene_2",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "أكثر من 15 مبادرة",
        "narration": "المنصة بتجمع أكتر من خمستاشر مبادرة تدريب، منها شهادات جوجل المهنية، وهَسل أكاديمي للأعمال، وتدريب جوجل كلاود. يعني المسار بيتحدد حسب احتياجك، مش كورس واحد للكل.",
        "visual": {
          "kind": "platform",
          "labels": [
            "شهادات مهنية",
            "تدريب للأعمال",
            "مهارات السحابة والذكاء الاصطناعي"
          ]
        },
        "id": "scene_3",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "دروس تشتغل بدون اتصال",
        "narration": "وجوجل بتقول إنك تقدر تنزّل دروس قصيرة وأنت على الواي فاي، وتكمّلها بعدين بدون بيانات الهاتف. ميزة عملية، خصوصًا لما باقة الإنترنت تبقى مش موافقة على طموحك.",
        "visual": {
          "kind": "platform",
          "labels": [
            "تنزيل الدروس عند الاتصال",
            "إكمال وحدات بدون بيانات الهاتف",
            "تصميم خفيف للهواتف"
          ]
        },
        "id": "scene_4",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "سكَاوْت يساعدك في الدراسة",
        "narration": "وفيه مساعد دراسة بالذكاء الاصطناعي اسمه سكاوت، يرد على الأسئلة ويقترح خطوات وجدول تعلّم. مساعد للمذاكرة؛ مش ضمان وظيفة، ولا بديل عن إنك تفهم وتطبّق بنفسك.",
        "visual": {
          "kind": "platform",
          "labels": [
            "أسئلة أثناء التعلّم",
            "اقتراح خطوات تالية",
            "تنظيم جدول الدراسة"
          ]
        },
        "id": "scene_5",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "متاحة مجانًا حسب الإعلان",
        "narration": "بحسب الإعلان، المنصة مجانية ومفتوحة للطلاب وأصحاب الأعمال والمطورين. لو هتجربها، اختار مهارة محتاجها وابدأ بوحدة صغيرة؛ فتح تبويب جديد لوحده مش بيزوّد الخبرة، للأسف.",
        "visual": {
